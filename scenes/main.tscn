[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/arena.gd" id="1_arena"]
[ext_resource type="Script" path="res://scripts/player.gd" id="2_player"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="3_hud"]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
; 纸白背景。整套黑白手绘风格里，背景不是“天空”而是那张纸。
background_color = Color(0.965, 0.953, 0.925, 1)
ambient_light_source = 2
; 白色环境光 + 白色太阳：明暗差别只由朝向产生，没有色偏（黑白风格的前提）。
; 环境光取 0.75 而不是更高，是为了让背光面落在浅灰而不是纯白——那点灰就是“铅笔的排线”。
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 0.75
tonemap_mode = 2

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.4
height = 1.8

[node name="Main" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.643, -0.766, 0, 0.766, 0.643, 0, 14, 0)
light_color = Color(1, 1, 1, 1)
light_energy = 0.5
; 投影关掉：黑白线稿要的是平涂 + 墨线，硬阴影会在白墙上压出一片灰，
; 与“画上去的线”不是一回事。
shadow_enabled = false

[node name="Arena" type="Node3D" parent="."]
script = ExtResource("1_arena")

[node name="Player" type="CharacterBody3D" parent="." groups=["player"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 9)
script = ExtResource("2_player")

[node name="Shape" type="CollisionShape3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

[node name="SpringArm" type="SpringArm3D" parent="Player"]
; 抬高到 2.5：相机更高，角色在画面里就落得更低，准星周围（屏幕中间）能空出来。
; 1.5 时会看到角色正好挡在准星上。数值由快照里的 headScreenY 核对（0.62 左右合适）。
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.5, 0)
spring_length = 4.5

[node name="Camera3D" type="Camera3D" parent="Player/SpringArm"]

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")
; 准星、血量条、记分板等控件全部由 hud.gd 在 _ready 里建。
; 这里刻意不留任何子节点：准星的五个部件尺寸必须一起调，
; 分成“中心在场景、刻度在代码”两处时，只改一边就会对不上。
