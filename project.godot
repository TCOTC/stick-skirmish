; Engine configuration file.
; Stick Skirmish —— 双人局域网 3D 第三人称射击
;
; 注意：网页版只能用 Compatibility 渲染器（WebGL 2）。
; Forward+ / Mobile 在 web 平台不支持，所以这里从一开始就锁死 gl_compatibility。

config_version=5

[application]

config/name="Stick Skirmish"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; 短命的视觉特效（曳光、弹着点）。只在本机播放，不参与同步。
Fx="*res://scripts/fx.gd"

; 联机：每个客户端广播自己的位置，并为其他玩家画替身（见 scripts/net.gd）。
Net="*res://scripts/net.gd"

; 比分与回合：谁打倒了谁、什么时候到分数上限、下一回合怎么开（见 scripts/match.gd）。
; 放在 Net 之后：它在 _ready 里要读网址参数，用的是 Net 的 query_param。
Match="*res://scripts/match.gd"

; 程序化音效（无素材，启动时合成 wav）。见 scripts/sfx.gd。
Sfx="*res://scripts/sfx.gd"

; 临时：联机连通性探针，只有网址带 ?probe=1 时才做事。
; 验证完联机方案后连同 scripts/net_probe.gd 一起删。
NetProbe="*res://scripts/net_probe.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 线稿风格全靠细线：不开 MSAA 的话远处的棱线会碎成虚线（实测 2x 仍有，取 4x）。
anti_aliasing/quality/msaa_3d=2
